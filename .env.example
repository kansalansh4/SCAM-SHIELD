# Copy to .env.local. Emulator-only identifiers, not a real cloud project.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_PROJECT_ID=demo-scam-shield
VITE_FIREBASE_AUTH_DOMAIN=demo-scam-shield.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-scam-shield
VITE_FUNCTIONS_REGION=us-central1
# For staging/production set emulator mode false, real public web config,
# and a reCAPTCHA Enterprise App Check site key. Never add service-account keys.
VITE_APPCHECK_SITE_KEY=
