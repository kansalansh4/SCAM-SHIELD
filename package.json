{
  "name": "scam-shield",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/sync-shared.mjs && node scripts/prepare-ocr.mjs && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "vitest run tests/rules.test.js tests/contracts.test.js",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-scam-shield 'vitest run --config vitest.integration.config.js'",
    "test:e2e": "playwright test",
    "emulators": "node scripts/prepare-emulators.mjs && firebase emulators:start --only auth,firestore,functions --project demo-scam-shield",
    "prepare:functions": "node scripts/sync-shared.mjs",
    "seed:emulators": "node scripts/seed-emulators.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "format": "prettier --write .",
    "test:e2e:full": "node scripts/prepare-emulators.mjs && firebase emulators:exec --only auth,firestore,functions --project demo-scam-shield \"node scripts/run-full-e2e.mjs\""
  },
  "dependencies": {
    "firebase": "12.2.1",
    "lucide-react": "0.542.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.4",
    "zod": "4.1.5",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@firebase/rules-unit-testing": "5.0.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.1.13",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "firebase-tools": "15.30.2",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "sharp": "0.35.4",
    "tailwindcss": "4.1.13",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "@tesseract.js-data/eng": "1.0.0",
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.4.0"
  }
}
